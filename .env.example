# Copy this file to .env.local and fill in your values. Never commit .env.local to git.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional: override the default models used by llm_client.py
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5.5

# --- MySQL (used by the mysql Docker container on first boot) ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=adblock
MYSQL_USER=adblock
MYSQL_PASSWORD=changeme

# --- Database connection (used by backend code) ---
DATABASE_URL=mysql+pymysql://adblock:changeme@db:3306/adblock
