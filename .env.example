# Copy this file to .env.local and fill in your values. Never commit .env.local to git.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional: override the default models used by llm_client.py
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5.5

# --- MySQL (required by docker-compose db service) ---
MYSQL_ROOT_PASSWORD=adblock_root
MYSQL_DATABASE=adblock
MYSQL_USER=adblock
MYSQL_PASSWORD=adblock_pass
DATABASE_URL=mysql+pymysql://adblock:adblock_pass@db:3306/adblock

# --- Worker ---
WORKER_SLEEP_SECONDS=300
WORKER_LOG_LEVEL=INFO
