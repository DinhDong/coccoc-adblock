# Copy this file to .env.local and fill in your values.
# Never commit .env.local or real credentials to version control.

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key
# Optional: override the default models used by llm_client.py
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5.5

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=6446
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password

# --- Ceph / S3-compatible object storage ---
S3_ENABLED=true
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
AWS_ENDPOINT=https://your-s3-endpoint.example.com
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your_bucket_name
S3_VERIFY_SSL=true
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# --- Upload API ---
UPLOAD_API_KEY=your_upload_api_key
MAX_IMAGE_UPLOAD_MB=20
PRESIGNED_URL_EXPIRES_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Worker ---
WORKER_SLEEP_SECONDS=300
WORKER_LOG_LEVEL=INFO
# true = the worker also claims drafts, so every ticket runs as soon as it is
# created and pressing Run becomes optional. false = only tickets sent to the
# pipeline (status "new") are picked up.
WORKER_CLAIM_DRAFTS=false
